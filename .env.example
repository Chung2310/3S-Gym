# ===========================
# SERVER CONFIG
# ===========================
NODE_ENV=production
PORT=3008
MONGODB_URI=mongodb://localhost:27017/3sgym
MONGODB_USER=
MONGODB_PASSWORD=
MONGODB_AUTH_SOURCE=admin

# ===========================
# AUTH
# ===========================
# Dùng để ký JWT token. Sinh ngẫu nhiên: openssl rand -hex 64
JWT_SECRET=
CORS_ORIGINS=http://localhost:3008
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_FULL_NAME=Quản lý cấp cao 3S

# ===========================
# AI / OPENROUTER
# ===========================
OPENROUTER_API_KEY=

# URL của ứng dụng (dùng làm HTTP-Referer gửi lên OpenRouter)
APP_URL=https://3sgym.vn

# ===========================
# CREDIT PAYMENTS (SePay VietQR + authenticated webhook)
# BANK_CODE: QR bank alias/code; BANK_NAME: exact webhook gateway name, e.g. Vietcombank
SEPAY_BANK_CODE=
SEPAY_BANK_NAME=
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_HOLDER=
SEPAY_WEBHOOK_API_KEY=
# Optional virtual-account routing / required bank memo prefix
SEPAY_QR_ACCOUNT_NUMBER=
SEPAY_SUB_ACCOUNT=
# App webhook routing prefix: 2-5 ASCII letters/digits including at least one letter, e.g. SG -> SG SG12345678; blank preserves legacy CR codes
SEPAY_TRANSFER_NOTE=
SEPAY_TRANSFER_PREFIX=

# Legacy PayOS credentials: retain until existing pending orders are reconciled
# ===========================
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=http://localhost:3008/portal/wallet/payment-result
PAYOS_CANCEL_URL=http://localhost:3008/portal/wallet

VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=https://3sgym.vn/wallet/payment-result
VNPAY_IPN_URL=https://3sgym.vn/api/credits/payments/vnpay/ipn
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_API_URL=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=https://3sgym.vn/wallet/payment-result
MOMO_IPN_URL=https://3sgym.vn/api/credits/payments/momo/ipn

# ===========================
# FRONTEND (build-time, Vite)
# ===========================
# URL gốc của backend API (chỉ cần set khi deploy tách biệt frontend)

# ===========================
# CLOUDINARY CONFIG
# ===========================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
