# ===========================
# SERVER CONFIG
# ===========================
PORT=3008
MONGODB_URI=mongodb://localhost:27017/3sgym
MONGODB_USER=
MONGODB_PASSWORD=
MONGODB_AUTH_SOURCE=admin

# ===========================
# AUTH
# ===========================
# Dùng để ký JWT token. Sinh ngẫu nhiên: openssl rand -hex 64
JWT_SECRET=
JWT_ISSUER=3s-gym
JWT_AUDIENCE=3s-gym-api
CORS_ORIGINS=http://localhost:3008
TRUST_PROXY=false
JSON_BODY_LIMIT=1mb
PROVIDER_TIMEOUT_MS=15000
AUTH_RATE_LIMIT_PER_15M=20
AI_RATE_LIMIT_PER_MINUTE=10
OCR_MAX_FILE_BYTES=8388608
VECTOR_SEARCH_MODE=local
VECTOR_SEARCH_INDEX=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Quản lý 3S
LOG_LEVEL=info
LOG_MAX_STRING_LENGTH=2000
LOG_MAX_DEPTH=4
LOG_MAX_COLLECTION_ITEMS=25
ERROR_DEBUG=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
APP_RELEASE=
SHUTDOWN_TIMEOUT_MS=10000

# ===========================
# AI / OPENROUTER

# ===========================
# AI / OPENROUTER
# ===========================
OPENROUTER_API_KEY=

# URL của ứng dụng (dùng làm HTTP-Referer gửi lên OpenRouter)
APP_URL=https://3sgym.vn

# ===========================
# FRONTEND (build-time, Vite)
# ===========================
# URL gốc của backend API (chỉ cần set khi deploy tách biệt frontend)

# ===========================
# CLOUDINARY CONFIG
# ===========================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
