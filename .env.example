# ===========================
# SERVER CONFIG
# ===========================
PORT=3008
MONGODB_URI=mongodb://localhost:27017/igen-erp
MONGODB_USER=
MONGODB_PASSWORD=
MONGODB_AUTH_SOURCE=admin

# ===========================
# AUTH
# ===========================
# Dùng để ký JWT token. Sinh ngẫu nhiên: openssl rand -hex 64
JWT_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Quản lý 3S
LOG_LEVEL=info
LOG_PRETTY=false
ERROR_DEBUG=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
APP_RELEASE=
SHUTDOWN_TIMEOUT_MS=10000

# ===========================
# AI / OPENROUTER

# ===========================
# AI / OPENROUTER
# ===========================
OPENROUTER_API_KEY=

# URL của ứng dụng (dùng làm HTTP-Referer gửi lên OpenRouter)
APP_URL=https://3sgym.vn

# ===========================
# FRONTEND (build-time, Vite)
# ===========================
# URL gốc của backend API (chỉ cần set khi deploy tách biệt frontend)

# ===========================
# CLOUDINARY CONFIG
# ===========================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
