{
  "name": "3s-gym",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch backend/dev.ts",
    "dev:backend": "tsx watch backend/dev.ts",
    "start": "tsx backend/bootstrap.ts",
    "start:production": "node dist/backend/bootstrap.js",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "typecheck:backend": "tsc --noEmit -p tsconfig.backend.json",
    "build:backend": "tsc -p tsconfig.backend.build.json",
    "test:backend": "vitest run --config vitest.config.ts backend/tests",
    "lint:backend": "oxlint backend vitest.config.ts",
    "smoke:production": "node scripts/production-smoke.mjs",
    "verify:backend": "npm run test:backend && npm run typecheck:backend && npm run lint:backend && npm run build:backend && npm run smoke:production",
    "lint": "oxlint backend frontend vite.config.ts vitest.config.ts",
    "test": "vitest run --config vitest.config.ts",
    "db:migrate": "tsx backend/scripts/migrate.ts up",
    "db:migrate:down": "tsx backend/scripts/migrate.ts down",
    "db:migrate:status": "tsx backend/scripts/migrate.ts status",
    "db:seed": "tsx backend/scripts/seed.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.31.0",
    "mongoose": "^9.9.2",
    "multer": "^2.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.5",
    "jsdom": "^30.0.1",
    "mongodb-memory-server": "^11.2.0",
    "oxlint": "^1.75.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  }
}
